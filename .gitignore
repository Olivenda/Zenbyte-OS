kernel/*
iso/boot/initramfs.img
iso/boot/vmlinuz
*.iso
repo/*

# Generated by `make iso` / `make initramfs`
build/iso-stage/
build/pkgs/
init.cpio.tmp

# zbpm signing keys — NEVER commit these
tools/keys/
*.asc
*.sig

# Packages/ build artifacts — never commit compiled objects
Packages/**/*.o
Packages/**/*.Po
Packages/**/autom4te.cache/
Packages/**/.deps/
Packages/**/config.log
Packages/**/config.status

# Local editor / OS clutter
*.swp
.DS_Store
rootfs/etc/localtime
