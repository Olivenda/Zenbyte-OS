#!/usr/bin/env bash
# build-test-pkg — produce a minimal hand-crafted zbpm package staging dir
# without any external package manager. Useful for testing zbpm-repo and the
# install path on systems where dnf isn't available.
#
# Output matches the contract consumed by tools/zbpm-repo:
#   <out-dir>/<name>/<name>.tar.gz
#                    <name>.version
#                    <name>.deps
#                    <name>.info
#
# Usage:
#   tools/build-test-pkg                           # produces 'hello'
#   tools/build-test-pkg --name hello --version 1.0
#   tools/build-test-pkg --out-dir build/pkgs

set -euo pipefail

NAME="hello"
VERSION="1.0.0-1.zb"
OUT_DIR="$PWD/build/pkgs"

while [ $# -gt 0 ]; do
  case "$1" in
    --name)    NAME="$2"; shift 2 ;;
    --version) VERSION="$2"; shift 2 ;;
    --out-dir) OUT_DIR="$2"; shift 2 ;;
    -h|--help) sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done

[[ "$NAME" =~ ^[A-Za-z0-9_+][A-Za-z0-9_.+-]{0,63}$ ]] \
  || { echo "invalid name: $NAME" >&2; exit 2; }

mkdir -p "$OUT_DIR"
OUT_DIR=$(cd "$OUT_DIR" && pwd)

work=$(mktemp -d -t zbpm-testpkg.XXXXXX)
trap 'rm -rf "$work"' EXIT

stage="$work/stage"
mkdir -p "$stage/usr/bin" "$stage/META"

# A simple program at /usr/bin/<name>
cat > "$stage/usr/bin/$NAME" <<EOF
#!/bin/sh
echo "Hello from the zbpm test package: $NAME $VERSION"
EOF
chmod 0755 "$stage/usr/bin/$NAME"

# Optional postinst — proves the META/postinst path is honoured.
cat > "$stage/META/postinst" <<EOF
#!/bin/sh
echo "[$NAME] postinst ran ok"
EOF
chmod 0755 "$stage/META/postinst"

dst="$OUT_DIR/$NAME"
rm -rf "$dst"; mkdir -p "$dst"

echo "$VERSION" > "$dst/$NAME.version"
: > "$dst/$NAME.deps"   # no deps
{
  echo "Name:    $NAME"
  echo "Version: $VERSION"
  echo "Summary: Hand-crafted zbpm test package"
  echo "License: MIT"
} > "$dst/$NAME.info"

mtime="${SOURCE_DATE_EPOCH:-1700000000}"
( cd "$stage" && \
  find . -mindepth 1 -print0 \
    | LC_ALL=C sort -z \
    | tar --no-recursion --null --files-from=- \
          --owner=0 --group=0 --numeric-owner \
          --mtime="@$mtime" \
          -czf "$dst/$NAME.tar.gz" \
)

echo "==> $NAME $VERSION at $dst/"
tar -tzf "$dst/$NAME.tar.gz"
